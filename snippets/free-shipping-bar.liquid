{%- comment -%}
  Renders a free-shipping progress bar. Re-rendered server-side on every AJAX
  cart update, so the progress stays accurate without extra JS.
{%- endcomment -%}
{%- if settings.enable_free_shipping_bar and settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign pct = cart.total_price | times: 100.0 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  -%}
  <div class="ship-bar{% if remaining <= 0 %} ship-bar--complete{% endif %}">
    <p class="ship-bar__msg">
      {%- if remaining > 0 -%}
        {% render 'icon', icon: 'truck' %} <span>You're <strong>{{ remaining | money }}</strong> from complimentary shipping</span>
      {%- else -%}
        {% render 'icon', icon: 'check' %} <span>You've unlocked <strong>complimentary shipping</strong></span>
      {%- endif -%}
    </p>
    <div class="ship-bar__track"><div class="ship-bar__fill" style="width: {{ pct }}%"></div></div>
  </div>
{%- endif -%}
