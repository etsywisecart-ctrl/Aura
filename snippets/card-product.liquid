{%- comment -%}
  Renders a product card in the Aura language.
  Accepts:
    card_product          {Object}  product (optional — omit for a placeholder)
    media_aspect_ratio    {String}  'adapt' | 'portrait' | 'square'
    show_vendor           {Boolean}
    show_secondary_image  {Boolean}
    lazy_load             {Boolean}
    placeholder           {String}  placeholder svg name for onboarding
{%- endcomment -%}
{%- liquid
  assign ratio = media_aspect_ratio | default: settings.card_image_ratio | default: 'portrait'
  if show_secondary_image == nil
    assign show_secondary_image = settings.card_show_secondary_image
  endif
  if show_vendor == nil
    assign show_vendor = settings.card_show_vendor
  endif
  assign loading = 'lazy'
  if lazy_load == false
    assign loading = 'eager'
  endif
-%}
<div class="card-wrapper">
  {%- if card_product and card_product != empty -%}
    <div class="card card--{{ settings.card_style }}">
      <div class="card__media">
        <a href="{{ card_product.url }}" class="media media--{{ ratio }} zoom-on-hover"
          {% if ratio == 'adapt' and card_product.featured_media %}style="--ratio-percent: {{ 1 | divided_by: card_product.featured_media.aspect_ratio | times: 100 }}%;"{% endif %}
          aria-label="{{ card_product.title | escape }}">
          {%- if card_product.featured_media -%}
            <img
              srcset="
                {%- if card_product.featured_media.width >= 360 %}{{ card_product.featured_media | image_url: width: 360 }} 360w,{% endif -%}
                {%- if card_product.featured_media.width >= 540 %}{{ card_product.featured_media | image_url: width: 540 }} 540w,{% endif -%}
                {%- if card_product.featured_media.width >= 720 %}{{ card_product.featured_media | image_url: width: 720 }} 720w,{% endif -%}
                {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w"
              sizes="(min-width: 990px) 360px, (min-width: 750px) 33vw, 50vw"
              src="{{ card_product.featured_media | image_url: width: 540 }}"
              alt="{{ card_product.featured_media.alt | escape }}"
              width="{{ card_product.featured_media.width }}"
              height="{{ card_product.featured_media.height }}"
              loading="{{ loading }}"
              class="card__image image-fade">
            {%- if show_secondary_image and card_product.media[1] != nil -%}
              <img
                src="{{ card_product.media[1] | image_url: width: 540 }}"
                alt=""
                width="{{ card_product.media[1].width }}"
                height="{{ card_product.media[1].height }}"
                loading="lazy"
                class="card__image card__image--secondary">
            {%- endif -%}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>

        {%- if card_product.available == false -%}
          <span class="card__badge badge badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif card_product.compare_at_price > card_product.price -%}
          <span class="card__badge badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
        {%- endif -%}
      </div>

      <div class="card__content">
        {%- if show_vendor and card_product.vendor != blank -%}
          <span class="visually-hidden">{{ 'products.product.vendor' | t }}</span>
          <span class="card__vendor">{{ card_product.vendor }}</span>
        {%- endif -%}
        <h3 class="card__heading">
          <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
        </h3>
        {%- render 'price', product: card_product, use_variant: true -%}
      </div>
    </div>
  {%- else -%}
    <div class="card card--{{ settings.card_style }}">
      <div class="card__media">
        <div class="media media--{{ ratio }}">
          {{ placeholder | default: 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      </div>
      <div class="card__content">
        <h3 class="card__heading">{{ 'onboarding.product_title' | t }}</h3>
        <div class="price"><span class="price-item price-item--regular">{{ 4900 | money }}</span></div>
      </div>
    </div>
  {%- endif -%}
</div>
