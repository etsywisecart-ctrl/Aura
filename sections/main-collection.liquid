{%- comment -%} Aura — Main collection (editorial grid + calm filters) {%- endcomment -%}
{%- liquid
  assign show_filters = false
  if section.settings.enable_filtering or section.settings.enable_sorting
    assign show_filters = true
  endif
-%}
{%- paginate collection.products by section.settings.products_per_page -%}
<section class="section collection-section">
  <div class="page-width">

    {%- comment -%} Editorial header {%- endcomment -%}
    <header class="collection-hero scroll-trigger">
      <div class="collection-hero__inner">
        <span class="eyebrow">{{ 'sections.collection_template.title' | t }}</span>
        <h1 class="collection-hero__title h0">{{ collection.title | escape }}</h1>
        {%- if collection.description != blank and section.settings.show_description -%}
          <div class="collection-hero__description rte">{{ collection.description }}</div>
        {%- endif -%}
      </div>
    </header>

    {%- if show_filters -%}
      <div class="facets">
        <div class="facets__left" style="display:flex; align-items:center; gap:1.6rem;">
          {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
            <button type="button" class="facets__toggle" data-drawer-open="filter-drawer" aria-haspopup="dialog">
              {% render 'icon', icon: 'hamburger' %} {{ 'products.facets.filter_button' | t }}
            </button>
          {%- endif -%}
          <span class="product-count">{{ 'products.facets.product_count_simple' | t: count: collection.products_count }}</span>
        </div>
        {%- if section.settings.enable_sorting -%}
          <div class="facets__sort">
            <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <select name="sort_by" id="SortBy" form="FacetFiltersForm" onchange="this.form.submit()">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Active filters {%- endcomment -%}
      {%- assign has_active = false -%}
      {%- for filter in collection.filters -%}{%- if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil -%}{%- assign has_active = true -%}{%- endif -%}{%- endfor -%}
      {%- if has_active -%}
        <div class="active-facets">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a href="{{ value.url_to_remove }}" class="active-facet">{{ value.label | escape }} {% render 'icon', icon: 'close' %}</a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                <a href="{{ filter.url_to_remove }}" class="active-facet">{{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }} {% render 'icon', icon: 'close' %}</a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <a href="{{ collection.url }}" class="link">{{ 'products.facets.clear_all' | t }}</a>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Product grid {%- endcomment -%}
    {%- if collection.products.size > 0 -%}
      <div class="grid grid--{{ section.settings.columns_desktop }} grid--1-col-mobile" id="product-grid">
        {%- for product in collection.products -%}
          {% render 'card-product', card_product: product, media_aspect_ratio: section.settings.image_ratio, lazy_load: forloop.index > 8 %}
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <div class="empty-state">
        <p class="h3">{{ 'sections.collection_template.empty' | t }}</p>
        <a href="{{ collection.url }}" class="button button--secondary">{{ 'products.facets.clear_all' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} Filter drawer {%- endcomment -%}
{%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
  <side-drawer id="filter-drawer" class="drawer filter-drawer menu-drawer" aria-hidden="true">
    <div class="drawer__overlay" tabindex="-1"></div>
    <div class="drawer__inner" role="dialog" aria-modal="true" aria-label="{{ 'products.facets.filter_button' | t }}">
      <div class="drawer__header">
        <span class="drawer__heading">{{ 'products.facets.filter_button' | t }}</span>
        <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
      </div>
      <form id="FacetFiltersForm" class="drawer__body facets__form">
        {%- for filter in collection.filters -%}
          <details class="accordion" open>
            <summary>{{ filter.label | escape }} {% render 'icon', icon: 'caret' %}</summary>
            <div class="accordion__content">
              {%- case filter.type -%}
                {%- when 'list', 'boolean' -%}
                  <ul class="list-unstyled" style="display:flex;flex-direction:column;gap:1rem;">
                    {%- for value in filter.values -%}
                      <li>
                        <label style="display:flex;align-items:center;gap:1rem;cursor:pointer;">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %} style="width:auto;min-height:auto;">
                          <span>{{ value.label | escape }} <span class="caption">({{ value.count }})</span></span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div style="display:flex;gap:1rem;align-items:center;">
                    <div class="field"><label>{{ 'products.facets.from' | t }}</label><input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | default: '' }}" placeholder="0" min="0" max="{{ filter.range_max | money_without_currency }}"></div>
                    <div class="field"><label>{{ 'products.facets.to' | t }}</label><input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | default: '' }}" placeholder="{{ filter.range_max | money_without_currency }}" min="0" max="{{ filter.range_max | money_without_currency }}"></div>
                  </div>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
        <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
      </form>
      <div class="drawer__footer" style="display:flex;gap:1rem;">
        <a href="{{ collection.url }}" class="button button--secondary button--full">{{ 'products.facets.clear_all' | t }}</a>
        <button type="submit" form="FacetFiltersForm" class="button button--full">{{ 'products.facets.apply' | t }}</button>
      </div>
    </div>
  </side-drawer>
{%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    { "type": "checkbox", "id": "show_description", "default": true, "label": "Show collection description" },
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "default": 24, "label": "Products per page" },
    { "type": "select", "id": "columns_desktop", "options": [
      { "value": "2", "label": "2 columns" },
      { "value": "3", "label": "3 columns" },
      { "value": "4", "label": "4 columns" }
    ], "default": "3", "label": "Columns on desktop" },
    { "type": "select", "id": "image_ratio", "options": [
      { "value": "adapt", "label": "Adapt" },
      { "value": "portrait", "label": "Portrait" },
      { "value": "square", "label": "Square" }
    ], "default": "portrait", "label": "Image ratio" },
    { "type": "header", "content": "Filtering and sorting" },
    { "type": "checkbox", "id": "enable_filtering", "default": true, "label": "Enable filtering", "info": "Customize filters in Search & Discovery." },
    { "type": "checkbox", "id": "enable_sorting", "default": true, "label": "Enable sorting" }
  ]
}
{% endschema %}
