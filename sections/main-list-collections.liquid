{%- comment -%} Aura — List collections {%- endcomment -%}
<section class="section">
  <div class="page-width">
    <header class="collection-hero scroll-trigger">
      <span class="eyebrow">{{ shop.name }}</span>
      <h1 class="collection-hero__title h0">{{ section.settings.title | default: 'Collections' | escape }}</h1>
    </header>

    <div class="grid grid--{{ section.settings.columns_desktop }} grid--1-col-mobile scroll-trigger">
      {%- assign collections = collections -%}
      {%- if section.settings.sort == 'products_high' -%}{%- assign collections = collections | sort: 'all_products_count' | reverse -%}{%- endif -%}
      {%- for collection in collections -%}
        {% render 'card-collection', card_collection: collection, media_aspect_ratio: section.settings.image_ratio, heading_tag: 'h2', lazy_load: forloop.index > 6 %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Collections" },
    { "type": "select", "id": "sort", "options": [
      { "value": "alphabetical", "label": "Alphabetical" },
      { "value": "products_high", "label": "Most products" }
    ], "default": "alphabetical", "label": "Sort" },
    { "type": "select", "id": "columns_desktop", "options": [
      { "value": "2", "label": "2 columns" },
      { "value": "3", "label": "3 columns" },
      { "value": "4", "label": "4 columns" }
    ], "default": "3", "label": "Columns on desktop" },
    { "type": "select", "id": "image_ratio", "options": [
      { "value": "portrait", "label": "Portrait" },
      { "value": "square", "label": "Square" }
    ], "default": "portrait", "label": "Image ratio" }
  ]
}
{% endschema %}
