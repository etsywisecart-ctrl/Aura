{%- comment -%} Aura — Main product (premium) {%- endcomment -%}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign rating = product.metafields.reviews.rating.value
-%}
<section class="section product-section">
  <div class="page-width">

    {%- if section.settings.show_breadcrumbs -%}
      <nav class="breadcrumb product__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        {%- if product.collections.first -%}
          <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
        {%- endif -%}
        <span aria-current="page">{{ product.title | escape }}</span>
      </nav>
    {%- endif -%}

    <div class="product" id="Product-{{ section.id }}">

      {%- comment -%} Media — oversized, stacked {%- endcomment -%}
      <div class="product__media-wrapper">
        <div class="product__media-list">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div class="product__media" data-media-id="{{ media.id }}">
                {%- if forloop.first -%}
                  <div class="card__badges product__badges">
                    {%- if product.available == false -%}<span class="badge badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
                    {%- elsif product.compare_at_price > product.price -%}<span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <div class="media" style="padding-bottom: {{ 1 | divided_by: media.aspect_ratio | times: 100 }}%;">
                      <img src="{{ media | image_url: width: 1400 }}"
                        srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1100 }} 1100w, {{ media | image_url: width: 1400 }} 1400w"
                        sizes="(min-width: 990px) 55vw, 100vw" alt="{{ media.alt | escape }}"
                        width="{{ media.width }}" height="{{ media.height }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" class="image-fade">
                    </div>
                  {%- when 'video' -%}
                    <div class="media media--wide">{{ media | video_tag: image_size: '1100x', controls: true, preload: 'metadata' }}</div>
                  {%- when 'external_video' -%}
                    <div class="media media--wide">{{ media | external_video_tag }}</div>
                  {%- when 'model' -%}
                    <div class="media media--square">{{ media | model_viewer_tag }}</div>
                  {%- else -%}
                    <div class="media media--square">{{ media | media_tag }}</div>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="media media--portrait">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Info — the decision zone {%- endcomment -%}
      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}<div class="product__vendor eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</div>{%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title h1" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'rating' -%}
              {%- if rating != blank and rating.rating > 0 -%}
                <div class="product__rating" {{ block.shopify_attributes }}>
                  <span class="rating__stars"><span class="rating__fill" style="width: {{ rating.rating | times: 1.0 | divided_by: rating.scale_max | times: 100 }}%"></span></span>
                  {%- if product.metafields.reviews.rating_count -%}
                    <span class="rating__count">{{ rating.rating }} · {{ product.metafields.reviews.rating_count }} {{ 'general.accessibility.total_reviews' | t }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product__price" id="price-{{ section.id }}" {{ block.shopify_attributes }}>
                {% render 'price', product: product, use_variant: true, show_badges: true, show_savings: true %}
              </div>
              {%- if block.settings.show_taxes_note -%}<p class="caption product__tax-note">{{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}</p>{%- endif -%}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <variant-selects class="product-form__input" data-section="{{ section.id }}" data-url="{{ product.url }}" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign oname = option.name | downcase
                      assign is_color = false
                      if oname contains 'color' or oname contains 'colour'
                        assign is_color = true
                      endif
                      assign opt_index = option.position | minus: 1
                    -%}
                    <fieldset class="product-form__input variant-fieldset">
                      <legend>{{ option.name }}<span class="selected-value" data-option="{{ option.position }}">{{ option.selected_value }}</span></legend>
                      <div class="variant-options{% if is_color %} variant-options--swatch{% endif %}">
                        {%- for value in option.values -%}
                          <input type="radio" class="variant-option-input" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" name="{{ option.name }}-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                          {%- if is_color -%}
                            {%- liquid
                              assign swatch_url = ''
                              for v in product.variants
                                if v.options[opt_index] == value and v.featured_media
                                  assign swatch_url = v.featured_media | image_url: width: 100
                                  break
                                endif
                              endfor
                            -%}
                            {%- capture swatch_bg -%}{%- case value | downcase -%}{%- when 'black' -%}#1a1a1a{%- when 'white' -%}#f2f2f0{%- when 'ivory','cream' -%}#efe7d6{%- when 'grey','gray','charcoal' -%}#7c7d80{%- when 'navy' -%}#26314a{%- when 'blue' -%}#3a5f8a{%- when 'olive' -%}#6b7247{%- when 'green' -%}#3f6f52{%- when 'stone' -%}#b8ae9c{%- when 'sand','beige' -%}#d8c3a5{%- when 'tan','camel' -%}#c19a6b{%- when 'brown' -%}#6b4f3a{%- when 'red' -%}#9b2c2c{%- when 'pink' -%}#e0a9ac{%- else -%}#cfcabf{%- endcase -%}{%- endcapture -%}
                            <label class="variant-swatch" for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" title="{{ value | escape }}"{% if swatch_url != blank %} style="background-image:url({{ swatch_url }})"{% else %} style="background-color:{{ swatch_bg | strip }}"{% endif %}>
                              <span class="visually-hidden">{{ value }}</span>
                            </label>
                          {%- else -%}
                            <label class="variant-option-label" for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">{{ value }}</label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json">{{ product.variants | json }}</script>
                </variant-selects>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <product-form class="product-form" {{ block.shopify_attributes }}>
                <div class="product-form__error-message-wrapper hidden" role="alert"></div>
                {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', class: 'form' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  {%- if block.settings.show_quantity -%}
                    <div class="product-form__quantity">
                      <label class="form__label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
                      <quantity-input class="quantity">
                        <button class="quantity__button" name="minus" type="button" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">{% render 'icon', icon: 'minus' %}</button>
                        <input class="quantity__input" type="number" name="quantity" id="Quantity-{{ section.id }}" value="1" min="1" aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}">
                        <button class="quantity__button" name="plus" type="button" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">{% render 'icon', icon: 'plus' %}</button>
                      </quantity-input>
                    </div>
                  {%- endif -%}
                  <div class="product-form__buttons">
                    <button type="submit" name="add" class="button button--full button--primary"{% unless current_variant.available %} disabled{% endunless %}
                      data-add-label="{{ 'products.product.add_to_cart' | t }}" data-sold-out-label="{{ 'products.product.sold_out' | t }}" data-unavailable-label="{{ 'products.product.unavailable' | t }}">
                      <span>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                      {% render 'loading-spinner' %}
                    </button>
                    {%- if block.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
                  </div>
                {%- endform -%}
                {%- if block.settings.show_secure -%}
                  <div class="secure-checkout">
                    <span class="secure-checkout__label">{% render 'icon', icon: 'lock' %} {{ block.settings.secure_text | default: 'Secure, encrypted checkout' }}</span>
                    {%- if shop.enabled_payment_types.size > 0 -%}
                      <div class="payment-icons" role="list" aria-label="Payment methods">
                        {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </product-form>

            {%- when 'guarantees' -%}
              <ul class="product-trust" {{ block.shopify_attributes }}>
                {%- if block.settings.text_1 != blank -%}<li>{% render 'icon', icon: block.settings.icon_1 %} {{ block.settings.text_1 | escape }}</li>{%- endif -%}
                {%- if block.settings.text_2 != blank -%}<li>{% render 'icon', icon: block.settings.icon_2 %} {{ block.settings.text_2 | escape }}</li>{%- endif -%}
                {%- if block.settings.text_3 != blank -%}<li>{% render 'icon', icon: block.settings.icon_3 %} {{ block.settings.text_3 | escape }}</li>{%- endif -%}
              </ul>

            {%- when 'description' -%}
              {%- if product.description != blank -%}<div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>{%- endif -%}

            {%- when 'collapsible_tab' -%}
              <div class="product__accordion" {{ block.shopify_attributes }}>
                <details class="accordion"{% if block.settings.open_by_default %} open{% endif %}>
                  <summary>{{ block.settings.heading | default: block.settings.page.title | escape }}{% render 'icon', icon: 'caret' %}</summary>
                  <div class="accordion__content rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
                </details>
              </div>

            {%- when 'share' -%}
              <div class="product__share" {{ block.shopify_attributes }}>
                <a class="link" href="https://www.facebook.com/sharer.php?u={{ shop.url | append: product.url }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.alt_text.share_on_facebook' | t }}">{{ block.settings.share_label | default: 'Share' }}</a>
              </div>

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}

        {%- if product.selected_or_first_available_variant.sku != blank -%}
          <div class="product__meta"><span class="product__sku">{{ 'products.product.sku' | t }}: {{ product.selected_or_first_available_variant.sku }}</span></div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="product__sticky" id="ProductSticky-{{ section.id }}" aria-hidden="true">
    <div><p style="margin:0; font-size:1.4rem; font-weight:500;">{{ product.title | escape | truncate: 32 }}</p><div style="font-size:1.4rem;">{% render 'price', product: product, use_variant: true %}</div></div>
    <a href="#Product-{{ section.id }}" class="button button--compact">{{ 'products.product.add_to_cart' | t }}</a>
  </div>

  <script type="application/ld+json">
    { "@context": "http://schema.org/", "@type": "Product", "name": {{ product.title | json }}, "url": {{ shop.url | append: product.url | json }},
      "description": {{ product.description | strip_html | truncatewords: 60 | json }},
      {% if product.featured_media %}"image": [{{ product.featured_media | image_url: width: 1000 | prepend: "https:" | json }}],{% endif %}
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      {% if rating and rating.rating > 0 %}"aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ rating.rating | json }}, "bestRating": {{ rating.scale_max | json }}, "ratingCount": {{ product.metafields.reviews.rating_count | default: 1 | json }} },{% endif %}
      "offers": [{% for variant in product.variants %}{ "@type": "Offer", "price": {{ variant.price | divided_by: 100.0 | json }}, "priceCurrency": {{ cart.currency.iso_code | json }}, "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}", "sku": {{ variant.sku | json }} }{% unless forloop.last %},{% endunless %}{% endfor %}]
    }
  </script>
</section>

<script>
  (function () {
    var sticky = document.getElementById('ProductSticky-{{ section.id }}');
    var form = document.getElementById('{{ product_form_id }}');
    if (!sticky || !form || !('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { sticky.classList.toggle('is-visible', !e.isIntersecting && e.boundingClientRect.top < 0); });
    }, { threshold: 0 });
    io.observe(form);
  })();
</script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section-main-product",
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1, "settings": [] },
    { "type": "title", "name": "Title", "limit": 1, "settings": [] },
    { "type": "rating", "name": "Rating", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Shows a star rating from the reviews.rating product metafield (set by a reviews app)." }
    ]},
    { "type": "price", "name": "Price", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_taxes_note", "default": true, "label": "Show tax note" }
    ]},
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_quantity", "default": true, "label": "Show quantity selector" },
      { "type": "checkbox", "id": "show_dynamic_checkout", "default": true, "label": "Show dynamic checkout buttons" },
      { "type": "checkbox", "id": "show_secure", "default": true, "label": "Show secure-checkout line" },
      { "type": "text", "id": "secure_text", "default": "Secure, encrypted checkout", "label": "Secure text" }
    ]},
    { "type": "guarantees", "name": "Guarantees", "limit": 1, "settings": [
      { "type": "select", "id": "icon_1", "options": [
        {"value":"truck","label":"Shipping"},{"value":"return","label":"Returns"},{"value":"shield","label":"Guarantee"},{"value":"leaf","label":"Sustainable"},{"value":"lock","label":"Secure"},{"value":"gift","label":"Gift"}
      ], "default": "truck", "label": "Icon 1" },
      { "type": "text", "id": "text_1", "default": "Complimentary carbon-neutral shipping", "label": "Text 1" },
      { "type": "select", "id": "icon_2", "options": [
        {"value":"truck","label":"Shipping"},{"value":"return","label":"Returns"},{"value":"shield","label":"Guarantee"},{"value":"leaf","label":"Sustainable"},{"value":"lock","label":"Secure"},{"value":"gift","label":"Gift"}
      ], "default": "return", "label": "Icon 2" },
      { "type": "text", "id": "text_2", "default": "Thirty-day free returns", "label": "Text 2" },
      { "type": "select", "id": "icon_3", "options": [
        {"value":"truck","label":"Shipping"},{"value":"return","label":"Returns"},{"value":"shield","label":"Guarantee"},{"value":"leaf","label":"Sustainable"},{"value":"lock","label":"Secure"},{"value":"gift","label":"Gift"}
      ], "default": "shield", "label": "Icon 3" },
      { "type": "text", "id": "text_3", "default": "Backed by a lifetime guarantee", "label": "Text 3" }
    ]},
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    { "type": "collapsible_tab", "name": "Collapsible row", "settings": [
      { "type": "text", "id": "heading", "default": "Details", "label": "Heading" },
      { "type": "richtext", "id": "content", "label": "Content" },
      { "type": "page", "id": "page", "label": "Content from page" },
      { "type": "checkbox", "id": "open_by_default", "default": false, "label": "Open by default" }
    ]},
    { "type": "share", "name": "Share", "limit": 1, "settings": [
      { "type": "text", "id": "share_label", "default": "Share", "label": "Label" }
    ]},
    { "type": "@app" }
  ],
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "default": true, "label": "Show breadcrumbs" }
  ],
  "presets": [{
    "name": "Product",
    "blocks": [
      { "type": "vendor" }, { "type": "title" }, { "type": "rating" }, { "type": "price" },
      { "type": "variant_picker" }, { "type": "buy_buttons" }, { "type": "guarantees" },
      { "type": "description" }, { "type": "collapsible_tab" }, { "type": "share" }
    ]
  }]
}
{% endschema %}
