{%- comment -%} Aura — Password page {%- endcomment -%}
<div class="password color-scheme-1 gradient">
  <div class="password__main isolate">
    <div class="aura-glow" style="left:50%;top:38%;transform:translate(-50%,-50%);" aria-hidden="true"></div>
    <div class="isolate" style="display:flex;flex-direction:column;align-items:center;gap:2.4rem;max-width:52rem;">
      {%- if shop.brand_settings.logo != blank or settings.brand_image != blank -%}
        <img src="{{ settings.brand_image | default: shop.brand_settings.logo | image_url: width: 320 }}" alt="{{ shop.name | escape }}" style="width:160px;height:auto;" width="160" height="160">
      {%- else -%}
        <h1 class="password__logo">{{ shop.name }}</h1>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if shop.password_message != blank -%}
        <div class="password__message rte">{{ shop.password_message }}</div>
      {%- endif -%}

      {%- form 'storefront_password', class: 'password-form' -%}
        <div class="field">
          <label class="visually-hidden" for="password">{{ 'customer.log_in_page.password' | t }}</label>
          <input type="password" name="password" id="password" placeholder="{{ 'customer.log_in_page.password' | t }}" required{% if form.errors %} aria-invalid="true"{% endif %}>
        </div>
        <button type="submit" class="button" name="commit">{% render 'icon', icon: 'arrow' %}</button>
        {%- comment -%} The form object only exists inside this block. {%- endcomment -%}
        {%- if form.errors -%}
          <p class="form__message form__message--error" role="alert">{{ form.errors.messages.first }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <footer class="password__footer">
    {{ powered_by_link }}
  </footer>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }
  ]
}
{% endschema %}
