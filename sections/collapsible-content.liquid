{%- comment -%} Aura — Collapsible content (FAQ) {%- endcomment -%}
<div class="section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="faq scroll-trigger">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="faq__header">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="{{ section.settings.heading_size | default: 'h1' }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="faq__list">
        {%- for block in section.blocks -%}
          <details class="accordion"{% if block.settings.open_by_default %} open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              {{ block.settings.heading | escape }}
              {% render 'icon', icon: 'caret' %}
            </summary>
            <div class="accordion__content rte">{{ block.settings.content }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collapsible content",
  "tag": "section",
  "class": "section-collapsible",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Frequently asked" },
    { "type": "select", "id": "heading_size", "options": [{ "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }], "default": "h1", "label": "Heading size" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" }
  ],
  "blocks": [{
    "type": "row",
    "name": "Row",
    "settings": [
      { "type": "text", "id": "heading", "label": "Question", "default": "How long does shipping take?" },
      { "type": "richtext", "id": "content", "label": "Answer", "default": "<p>Orders ship carbon-neutral within 2–4 business days.</p>" },
      { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
    ]
  }],
  "presets": [{
    "name": "Collapsible content",
    "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }]
  }]
}
{% endschema %}
