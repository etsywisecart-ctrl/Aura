{%- comment -%} Aura — Cart items (page) {%- endcomment -%}
<section class="section cart-page-section">
  <div class="page-width page-width--medium">
    <div class="cart-page{% if cart == empty %} is-empty{% endif %}">
      <h1 class="cart-page__heading h1">{{ 'sections.cart.title' | t }}</h1>

      {%- if cart == empty -%}
        <div class="cart__empty">
          <p class="lead">{{ 'sections.cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
        </div>
      {%- else -%}
        <cart-items class="cart-items">
          <div id="main-cart-items" class="js-contents">
            <table class="cart-table">
              <thead>
                <tr>
                  <th colspan="2">{{ 'sections.cart.headings.product' | t }}</th>
                  <th>{{ 'sections.cart.headings.quantity' | t }}</th>
                  <th>{{ 'sections.cart.headings.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for item in cart.items -%}
                  <tr class="cart-item" data-index="{{ forloop.index }}">
                    <td class="cart-item__media" style="width:10rem;">
                      {%- if item.image -%}
                        <a href="{{ item.url }}"><img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="{{ 100 | divided_by: item.image.aspect_ratio | round }}" loading="lazy"></a>
                      {%- endif -%}
                    </td>
                    <td class="cart-item__details">
                      <a href="{{ item.url }}" class="cart-item__name">{{ item.product.title | escape }}</a>
                      {%- unless item.product.has_only_default_variant -%}
                        <div class="cart-item__options">
                          {%- for option in item.options_with_values -%}{{ option.name }}: {{ option.value }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}
                        </div>
                      {%- endunless -%}
                      {%- if item.selling_plan_allocation -%}<div class="cart-item__options">{{ item.selling_plan_allocation.selling_plan.name }}</div>{%- endif -%}
                      <div class="cart-item__price-wrapper" style="margin-top:0.4rem;">{{ item.original_price | money }}</div>
                    </td>
                    <td>
                      <div class="cart-item__quantity">
                        <quantity-input class="quantity">
                          <button class="quantity__button" name="minus" type="button" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}">{% render 'icon', icon: 'minus' %}</button>
                          <input class="quantity__input" type="number" name="updates[]" form="cart" data-index="{{ forloop.index }}" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}">
                          <button class="quantity__button" name="plus" type="button" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}">{% render 'icon', icon: 'plus' %}</button>
                        </quantity-input>
                        <button type="button" class="link cart-item__remove" data-remove data-index="{{ forloop.index }}">{{ 'sections.cart.remove_title' | t: title: item.product.title | escape }}</button>
                      </div>
                    </td>
                    <td class="cart-item__totals">
                      <div class="loading-overlay hidden"><div class="spinner"></div></div>
                      {{ item.original_line_price | money }}
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        </cart-items>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cart items",
  "class": "section-cart-items",
  "settings": []
}
{% endschema %}
