{%- comment -%} Aura — Collection list {%- endcomment -%}
<div class="section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.title != blank or section.settings.eyebrow != blank -%}
      <div class="section-header {% if section.settings.alignment == 'center' %}section-header--center{% endif %} scroll-trigger">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow{% if section.settings.alignment == 'center' %} eyebrow--center{% endif %}">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        {%- if section.settings.title != blank -%}<h2 class="{{ section.settings.heading_size | default: 'h1' }}">{{ section.settings.title | escape }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid grid--{{ section.settings.columns_desktop }} grid--1-col-mobile scroll-trigger">
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        <div class="collection-list__item" {{ block.shopify_attributes }}>
          <a href="{{ coll.url | default: '#' }}" class="media media--{{ section.settings.image_ratio }} zoom-on-hover" aria-label="{{ coll.title | default: block.settings.custom_title | escape }}">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 720 }}" srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 720 }} 720w" sizes="(min-width:990px) 33vw, 50vw" alt="{{ coll.title | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" class="image-fade">
            {%- elsif coll.featured_image != blank -%}
              <img src="{{ coll.featured_image | image_url: width: 720 }}" srcset="{{ coll.featured_image | image_url: width: 400 }} 400w, {{ coll.featured_image | image_url: width: 720 }} 720w" sizes="(min-width:990px) 33vw, 50vw" alt="{{ coll.featured_image.alt | escape }}" width="{{ coll.featured_image.width }}" height="{{ coll.featured_image.height }}" loading="lazy" class="image-fade">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>
          <h3 class="collection-list__title">
            <a href="{{ coll.url | default: '#' }}">
              {{ block.settings.custom_title | default: coll.title | default: 'onboarding.collection_title' | t }}
              {% render 'icon', icon: 'arrow' %}
            </a>
          </h3>
        </div>
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="collection-list__item">
            <div class="media media--{{ section.settings.image_ratio }}">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <h3 class="collection-list__title"><a href="#">{{ 'onboarding.collection_title' | t }}</a></h3>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "class": "section-collection-list",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Shop by category" },
    { "type": "select", "id": "heading_size", "options": [
      { "value": "h2", "label": "Small" },
      { "value": "h1", "label": "Medium" }
    ], "default": "h1", "label": "Heading size" },
    { "type": "select", "id": "alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "left", "label": "Alignment" },
    { "type": "select", "id": "columns_desktop", "options": [
      { "value": "2", "label": "2 columns" },
      { "value": "3", "label": "3 columns" },
      { "value": "4", "label": "4 columns" }
    ], "default": "3", "label": "Columns on desktop" },
    { "type": "select", "id": "image_ratio", "options": [
      { "value": "portrait", "label": "Portrait" },
      { "value": "square", "label": "Square" },
      { "value": "landscape", "label": "Landscape" }
    ], "default": "portrait", "label": "Image ratio" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" }
  ],
  "blocks": [{
    "type": "featured_collection",
    "name": "Collection",
    "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "custom_title", "label": "Custom title" },
      { "type": "image_picker", "id": "image", "label": "Custom image" }
    ]
  }],
  "presets": [{
    "name": "Collection list",
    "blocks": [{ "type": "featured_collection" }, { "type": "featured_collection" }, { "type": "featured_collection" }]
  }]
}
{% endschema %}
