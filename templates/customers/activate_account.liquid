{%- comment -%} Aura — Activate account {%- endcomment -%}
<div class="section">
  <div class="customer">
    <h1 class="customer__title h1">{{ 'customer.activate_account.title' | t }}</h1>
    <p class="center" style="margin-bottom:2rem;color:rgba(var(--color-foreground),0.7);">{{ 'customer.activate_account.subtext' | t }}</p>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}
        <p class="form__message form__message--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="customer__form">
        <div class="field">
          <label for="password">{{ 'customer.activate_account.password' | t }}</label>
          <input type="password" name="customer[password]" id="password" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label for="password_confirmation">{{ 'customer.activate_account.password_confirm' | t }}</label>
          <input type="password" name="customer[password_confirmation]" id="password_confirmation" autocomplete="new-password" required>
        </div>
        <div class="customer__actions">
          <button type="submit" name="commit" class="button button--full">{{ 'customer.activate_account.submit' | t }}</button>
          <button type="submit" name="decline" class="link">{{ 'customer.activate_account.cancel' | t }}</button>
        </div>
      </div>
    {%- endform -%}
  </div>
</div>
